<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Sandbox is deliberately absent; see ADR 008. It was bought for
	     a Mac App Store this account cannot reach, and under it Sparkle needs
	     two embedded XPC services and mach-lookup exceptions. Hardened Runtime
	     stays, in the build settings, and is what notarization requires.

	     This entitlement is not sandbox-only: Hardened Runtime reads the same
	     key for Photos access, so it must stay or the library is unreachable.
	     `files.user-selected.read-only` was sandbox-only and is gone. -->
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
</dict>
</plist>
